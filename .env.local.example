# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL_DOMAIN=azcreate27.co.jp
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=azcreate27.co.jp

# Cost guard
MONTHLY_API_BUDGET_USD=100
PER_APPLICATION_BUDGET_USD=1.0

# ポータル自動同期（Vercel Cron が /api/cron/portal-sync を叩く際の認証トークン。Vercel 側で同名の環境変数を設定）
CRON_SECRET=
# ローカルで同期を試すときに使う Chrome のパス（未設定ならインストール済み Chrome を自動検出）
# PORTAL_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# ベンダーのポータルパスワード暗号化キー（未設定なら ADMIN_SESSION_SECRET を流用）
# VENDOR_CREDENTIAL_KEY=
